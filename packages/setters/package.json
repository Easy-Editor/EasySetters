{
  "name": "@easy-editor/setters",
  "version": "0.1.6",
  "description": "Official setters library for EasyEditor - A collection of property setter components",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "unpkg": "dist/index.min.js",
    "jsdelivr": "dist/index.min.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.cjs"
      },
      "./styles.css": "./dist/styles.css"
    },
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/Easy-Editor/EasySetters",
  "license": "MIT",
  "author": "JinSo <kimjinso@qq.com>",
  "keywords": [
    "@easy-editor",
    "easyeditor",
    "low-code",
    "setter",
    "property-editor",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Easy-Editor/EasySetters",
    "directory": "packages/setters"
  },
  "bugs": {
    "url": "https://github.com/Easy-Editor/EasySetters/issues"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "build": "npm-run-all -nl build:*",
    "build:clean": "rimraf dist/",
    "build:js": "easypack build"
  },
  "peerDependencies": {
    "@easy-editor/core": "*",
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@easy-editor/easypack": "^0.0.2",
    "@rollup/plugin-alias": "^5.1.1",
    "@types/events": "^3.0.3",
    "postcss": "^8.5.6",
    "postcss-modules": "^6.0.1",
    "react-router-dom": "^7.1.1",
    "rollup-plugin-postcss": "^4.0.2"
  },
  "dependencies": {
    "@uiw/react-color-sketch": "^2.3.2",
    "@uiw/react-textarea-code-editor": "^3.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0"
  }
}
